+
+/// Keyboard, text and clipboard events need egui focus only; pointer and
+/// wheel events need the pointer over the widget only. Moving the pointer
+/// away must not stop typing.
+fn wants_event(has_focus: bool, has_pointer: bool, event: &egui::Event) -> bool {
+    match event {
+        egui::Event::Text(_)
+        | egui::Event::Key { .. }
+        | egui::Event::Copy
+        | egui::Event::Cut
+        | egui::Event::Paste(_) => has_focus,
+        egui::Event::MouseWheel { .. }
+        | egui::Event::PointerButton { .. }
+        | egui::Event::PointerMoved(_) => has_pointer,
+        _ => false,
+    }
+}
+
+/// Physical Ctrl (never the macOS Command key) + a letter or one of
+/// `[ \ ] Space` is the ASCII control byte a real terminal would send.
+/// Ctrl+Shift combinations are left alone: the widget's own clipboard
+/// bindings (Ctrl+Shift+C/V) live on that path.
+fn control_byte(key: Key, modifiers: Modifiers) -> Option<u8> {
+    if !modifiers.ctrl || modifiers.shift || modifiers.alt {
+        return None;
+    }
+    let name = key.symbol_or_name();
+    let mut chars = name.chars();
+    match (chars.next(), chars.next()) {
+        (Some(c), None) if c.is_ascii_alphabetic() => Some(c.to_ascii_lowercase() as u8 - b'a' + 1),
+        _ => match key {
+            Key::OpenBracket => Some(0x1b),
+            Key::Backslash => Some(0x1c),
+            Key::CloseBracket => Some(0x1d),
+            Key::Space => Some(0x00),
+            _ => None,
+        },
+    }
+}
+
+/// Shift+drag always selects locally, even when a TUI has mouse mode on
+/// (`process_mouse_move` already updates the selection while any modifier
+/// is held; this makes press and release agree with it).
+fn reports_to_tui(mouse_mode: bool, shift: bool) -> bool {
+    mouse_mode && !shift
+}
