+#[cfg(test)]
+mod gating_tests {
+    use super::*;
+
+    #[test]
+    fn keyboard_needs_focus_only_and_pointer_needs_hover_only() {
+        let key = egui::Event::Key { key: egui::Key::A, physical_key: None, pressed: true, repeat: false, modifiers: egui::Modifiers::NONE };
+        assert!(wants_event(true, false, &key));
+        assert!(!wants_event(false, true, &key));
+        let wheel = egui::Event::MouseWheel { unit: egui::MouseWheelUnit::Line, delta: egui::vec2(0.0, 1.0), phase: egui::TouchPhase::Move, modifiers: egui::Modifiers::NONE };
+        assert!(wants_event(false, true, &wheel));
+        assert!(!wants_event(true, false, &wheel));
+    }
+}
+
+#[cfg(test)]
+mod control_byte_tests {
+    use super::*;
+
+    #[test]
+    fn ctrl_letters_become_control_bytes() {
+        let ctrl = Modifiers { ctrl: true, ..Modifiers::NONE };
+        assert_eq!(control_byte(Key::S, ctrl), Some(0x13));
+        assert_eq!(control_byte(Key::Q, ctrl), Some(0x11));
+        assert_eq!(control_byte(Key::E, ctrl), Some(0x05));
+        assert_eq!(control_byte(Key::OpenBracket, ctrl), Some(0x1b));
+        assert_eq!(control_byte(Key::S, Modifiers::NONE), None);
+        assert_eq!(control_byte(Key::S, Modifiers { ctrl: true, shift: true, ..Modifiers::NONE }), None);
+        assert_eq!(control_byte(Key::S, Modifiers { mac_cmd: true, command: true, ..Modifiers::NONE }), None);
+    }
+}
+
+#[cfg(test)]
+mod mouse_mode_tests {
+    use super::*;
+    #[test]
+    fn shift_disables_mouse_reporting() {
+        assert!(reports_to_tui(true, false));
+        assert!(!reports_to_tui(true, true));
+        assert!(!reports_to_tui(false, false));
+    }
